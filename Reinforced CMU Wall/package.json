{
  "name": "bim-ar-cmu-wall",
  "version": "0.1.0",
  "private": true,
  "description": "Reinforced CMU wall construction sequence (Blender animation) in WebAR on a printed plan; reuses the parent repo's webpack toolchain",
  "scripts": {
    "build": "node ../node_modules/webpack/bin/webpack.js --config config/webpack.config.js",
    "serve": "node ../node_modules/webpack-dev-server/bin/webpack-dev-server.js --mode=development --config config/webpack.config.js --port 8036",
    "pack": "gltfpack -i blender/out/cmu_wall.raw.glb -o src/assets/cmu_wall.glb -cc -kn -km",
    "deploy": "npm run build && node scripts/deploy-pages.js"
  },
  "devDependencies": {
    "gltfpack": "1.3.0"
  }
}
