{
  "name": "bim-ar-hospital",
  "version": "0.1.0",
  "private": true,
  "description": "Hospital BIM (Arch, Structure, HVAC, Plumbing, Electrical, Fire Alarm) in WebAR on a printed sheet; reuses the parent repo's webpack toolchain",
  "scripts": {
    "build": "node ../node_modules/webpack/bin/webpack.js --config config/webpack.config.js",
    "serve": "node ../node_modules/webpack-dev-server/bin/webpack-dev-server.js --mode=development --config config/webpack.config.js --port 8034",
    "deploy": "npm run build && node scripts/deploy-pages.js"
  },
  "devDependencies": {
    "gltfpack": "1.3.0"
  }
}
